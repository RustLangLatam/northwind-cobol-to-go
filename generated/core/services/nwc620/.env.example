# nwc620 — invoice print (NWC620 / NWC620C). Every variable the service reads.

# --- gRPC server (svcruntime) ---
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
GRPC_TLS_CERT_FILE=/etc/nwc620/tls/tls.crt
GRPC_TLS_KEY_FILE=/etc/nwc620/tls/tls.key
GRPC_TLS_CLIENT_CA_FILE=
GRPC_ALLOW_PLAINTEXT=false
GRPC_ALLOW_PLAINTEXT_REMOTE=false
GRPC_AUTH_MODE=token
AUTH_TOKEN_SCHEMA=JWT
AUTH_TOKEN_PUBLIC_KEY=SET_ME
AUTH_TOKEN_ISSUER=
AUTH_TOKEN_AUDIENCE=nwc620
AUTH_TOKEN_ALLOW_ANY_AUDIENCE=false
AUTH_TOKEN_CLOCK_SKEW=30s
AUTH_TOKEN_MAX_LIFETIME=24h
AUTH_TOKEN_REQUIRED_SCOPES=
GRPC_MTLS_ALLOWED_CLIENTS=
GRPC_DEFAULT_TIMEOUT=30s
GRPC_MAX_CONCURRENT_STREAMS=100
GRPC_MAX_RECV_MSG_BYTES=4194304
SHUTDOWN_TIMEOUT=15s
READYZ_CACHE_TTL=2s

# --- Observability ---
LOG_LEVEL=info
LOG_FORMAT=json
METRICS_HOST=127.0.0.1
METRICS_PORT=9100
METRICS_BEARER_TOKEN_FILE=
METRICS_ALLOW_UNAUTHENTICATED=false
OTEL_SERVICE_NAME=nwc620
# Empty: tracing is off and the service still starts.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
# Not supported by the runtime (only logs a warning): use OTEL_EXPORTER_OTLP_ENDPOINT.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# --- Business clock (ACCEPT FROM DATE): the source system's zone (Northwind, Dallas) ---
SERVICE_TIME_ZONE=America/Chicago

# --- Db2 for i (existing schema; read only) ---
DB2_HOST=SET_ME
DB2_PORT=9471
DB2_LIBRARY=SET_ME
DB2_USER=SET_ME
DB2_PASSWORD=
# Required, no default. Not measured from the source (no SET OPTION COMMIT or
# STRCMTCTL found, the compile COMMIT parameter is not in the repository): the
# operator chooses *NONE, *CHG, *CS, *ALL or *RR.
DB2_COMMIT_MODE=
DB2_CCSID=SET_ME
DB2_CA_FILE=/etc/nwc620/db2/ca.crt
DB2_SERVER_NAME=
DB2_ALLOW_PLAINTEXT=false
DB2_MIN_PASSWORD_LEVEL=
DB2_MAX_ROWS=
DB2_MAX_LIMIT=
DB2_MAX_OPEN_CONNS=
DB2_MAX_IDLE_CONNS=
DB2_CONN_MAX_LIFETIME=
DB2_CONN_MAX_IDLE_TIME=
DB2_QUERY_TIMEOUT=

# --- Output target (QSYSPRT overridden to FORMTYPE(INVOICE) SPLFNAME(NWINVOICE)) ---
# Directory the invoice documents are written to (one .prt file per invoice).
NWC620_SPOOL_DIR=/var/spool/nwc620
# "true": with no spool directory, log each print record at Debug (contains business data).
NWC620_PRINT_TO_LOG=false
