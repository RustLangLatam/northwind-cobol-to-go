# .env.example — nwc700 service (Db2 for i, existing schema)
# The service reads its configuration from the environment only. Copy this file to
# .env, fill in the placeholders, and load it before starting the service:
#   set -a; . ./.env; set +a; ./nwc700-services
#
# This service only reads your EXISTING Db2 for i tables through
# milton_prism/pkg/db2access. It creates no tables, runs no migrations and ships no
# seed data; there is no database container in this deliverable.

# ── Db2 for i connection ─────────────────────────────────────────────────────
DB2_HOST=your-ibmi-host
# 9471 is the TLS host server (the default, with a verified certificate).
DB2_PORT=9471
# Library (schema) that holds your tables; also the default for unqualified names.
# One library replaces the job's library list (*LIBL): every unqualified table must
# be in DB2_LIBRARY. A table in another library needs a qualified name in the code.
DB2_LIBRARY=YOURLIB
DB2_USER=your-ibmi-user
# Keep the password in single quotes: the file is sourced by the shell.
DB2_PASSWORD='<your-ibmi-password>'
# Commitment control, REQUIRED (no default).
# Derived from the source (confirm it):
# No commitment-control statement in the 3 program(s) of this service, and every access reads:
# CUSMST (OPEN-INPUT, READ).
# A read-only port needs no commit boundary; *ALL or *RR would hold read locks with no COMMIT to release them.
# The service only reads: no file needs to be journaled for it.
# *ALL and *RR on a program that only reads still take read locks and hold them until
# a COMMIT that a read-only program never issues.
DB2_COMMIT_MODE=*NONE
# Default CCSID of your IBM i job, REQUIRED (273 on PUB400, 37 for US English or a 65535 job;
# ask the operator). A column without a CCSID clause takes it, and the host stores X'3F'
# without an error for a character it lacks, so the service checks text against it.
# 0 = explicit opt-out: only 7-bit ASCII is accepted there. 65535, 1200, 1208, 13488 are refused.
DB2_CCSID=SET_ME
# Lowest password level (QPWDLVL) the host may announce: 2, 3 or 4 (default 2: SHA-1 or
# PBKDF2, never DES). The host chooses the level; the client refuses a lower one before
# sending any password material.
DB2_MIN_PASSWORD_LEVEL=2
# PEM file with the CA that signed the host's certificate. Empty = the system roots.
# In a container a private CA is mounted at /etc/nwc700/db2-ca/ca.pem (see deploy/nwc700/db2-ca/).
DB2_CA_FILE=
# Name the certificate must carry (empty when it is DB2_HOST).
DB2_SERVER_NAME=
# true only for a plaintext host server (port 8471); never with port 9471.
DB2_ALLOW_PLAINTEXT=false
# Row cap of a query with no limit of its own (at most 1000000).
DB2_MAX_ROWS=10000
# Largest limit a query may ask for itself (default 100000, at most 1000000).
DB2_MAX_LIMIT=100000
# Pool bound: each open connection is one IBM i host job (1 to 256). The bound is per
# instance: host jobs = replicas x DB2_MAX_OPEN_CONNS (the k8s Deployment runs two).
DB2_MAX_OPEN_CONNS=10
# Idle connections kept open (0 = none; never above DB2_MAX_OPEN_CONNS).
DB2_MAX_IDLE_CONNS=2
# Lifetime of one connection, a Go duration from 1m to 24h.
DB2_CONN_MAX_LIFETIME=30m
# Idle time before a connection is closed, a Go duration from 10s up to the lifetime.
DB2_CONN_MAX_IDLE_TIME=5m
# Deadline of one statement, a Go duration (at most 1h).
DB2_QUERY_TIMEOUT=30s


# ── Service runtime (core/shared/svcruntime) ────────────────────────────────
# Every variable the runtime reads, with its safe default. Empty values marked
# REQUIRED stop the service from starting until you set them.
# bind address of the gRPC server (a container binds all interfaces)
GRPC_HOST=0.0.0.0
# gRPC port
GRPC_PORT=50052
# server certificate (PEM), from the Secret nwc700-tls; TLS is required
GRPC_TLS_CERT_FILE=/etc/nwc700/tls/tls.crt
# server key (PEM), from the same Secret
GRPC_TLS_KEY_FILE=/etc/nwc700/tls/tls.key
# set to /etc/nwc700/tls/ca.crt to require client certificates (mTLS)
GRPC_TLS_CLIENT_CA_FILE=
# true serves without TLS: local development only, never in a deployment; the bind is then 127.0.0.1
GRPC_ALLOW_PLAINTEXT=false
# true lets plaintext bind a non-loopback GRPC_HOST: bearer tokens then travel in clear; never in a deployment
GRPC_ALLOW_PLAINTEXT_REMOTE=false
# token (platform access token) or mtls (needs GRPC_TLS_CLIENT_CA_FILE)
GRPC_AUTH_MODE=token
# JWT or Paseto
AUTH_TOKEN_SCHEMA=JWT
# REQUIRED in token mode: Ed25519 public key of the token issuer, 64 hex characters (not a secret)
AUTH_TOKEN_PUBLIC_KEY=
# when set, the token issuer must match it
AUTH_TOKEN_ISSUER=
# the token audience must match (the service name; change it to your audience)
AUTH_TOKEN_AUDIENCE=nwc700
# true accepts a token for any audience: an explicit opt-out
AUTH_TOKEN_ALLOW_ANY_AUDIENCE=false
# tolerated clock difference with the token issuer (at most 2m)
AUTH_TOKEN_CLOCK_SKEW=30s
# a token that expires later than this from now is refused; keep it at least the issuer's access token lifetime
AUTH_TOKEN_MAX_LIFETIME=24h
# token mode: comma list of scopes every token must carry; empty requires none
AUTH_TOKEN_REQUIRED_SCOPES=
# REQUIRED in mtls mode: comma list of dns:NAME or uri:URI entries (cn:NAME is deprecated), e.g. dns:billing.internal,uri:spiffe://corp/billing
GRPC_MTLS_ALLOWED_CLIENTS=
# deadline applied when the caller sends none
GRPC_DEFAULT_TIMEOUT=30s
# concurrent streams per connection
GRPC_MAX_CONCURRENT_STREAMS=100
# largest accepted request message
GRPC_MAX_RECV_MSG_BYTES=4194304
# bind of the /health, /readyz and /metrics listener
METRICS_HOST=127.0.0.1
# port of that listener
METRICS_PORT=9101
# file holding the bearer token (16+ bytes) /metrics requires; /health and /readyz stay open; REQUIRED where METRICS_HOST is not loopback
METRICS_BEARER_TOKEN_FILE=
# true serves /metrics with no token beyond loopback: only behind a NetworkPolicy that limits who can scrape it
METRICS_ALLOW_UNAUTHENTICATED=false
# bound of the graceful stop
SHUTDOWN_TIMEOUT=15s
# how long a readiness result is reused
READYZ_CACHE_TTL=2s
# service name on every span
OTEL_SERVICE_NAME=nwc700
# OTLP/HTTP collector; empty turns tracing off
OTEL_EXPORTER_OTLP_ENDPOINT=
# true allows http:// to a collector that is not on loopback
OTEL_EXPORTER_OTLP_INSECURE=false
# REQUIRED: IANA zone of the source system (COBOL dates are local), e.g. Europe/Madrid; never UTC by default
SERVICE_TIME_ZONE=
# Logging
LOG_LEVEL=info
LOG_FORMAT=json
